# Python virtual environment (recreate with: py -3.15 -m venv .venv)
.venv/
venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets and machine-local config - never commit these
.env
.env.*
config.local.*
*.secret

# Logs
*.log
logs/

# Editors / OS clutter
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
